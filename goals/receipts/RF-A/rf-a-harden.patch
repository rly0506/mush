+def test_refresh_once_delayed_refusal_model_has_budget_to_reach_refused_fallback(monkeypatch):
+    delayed_refusal_seconds = 2.05
+    timeouts = []
+    local_calls = []
+
+    def delayed_refusal(_request, *, timeout):
+        timeouts.append(timeout)
+        if timeout <= delayed_refusal_seconds:
+            raise TimeoutError("timeout won the delayed-refusal race")
+        raise URLError(ConnectionRefusedError("listener eventually refused"))
+
+    monkeypatch.setattr(dossier_cli, "_open_loopback_json", delayed_refusal)
+    monkeypatch.setattr(dossier_cli, "_run_local_refresh_once", lambda: local_calls.append("refresh"))
+
+    result = CliRunner().invoke(dossier_cli.app, ["refresh-once"])
+
+    assert result.exit_code == 0
+    assert timeouts == [dossier_cli.HEALTH_TIMEOUT_SECONDS]
+    assert timeouts[0] > delayed_refusal_seconds
+    assert local_calls == ["refresh"]
+
+
