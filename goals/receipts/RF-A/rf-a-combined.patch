+    local_calls = []
+    monkeypatch.setattr(
+        dossier_cli,
+        "_open_loopback_json",
+        lambda _request, *, timeout: (_ for _ in ()).throw(transport_error),
+    )
+    monkeypatch.setattr(dossier_cli, "init_db", lambda: local_calls.append("init"))
+
+    result = CliRunner().invoke(dossier_cli.app, ["refresh-once"])
+
+    assert result.exit_code == 1
+    assert local_calls == []
+
+
+@pytest.mark.parametrize(
+    "transport_error",
+    [
+        URLError(ConnectionRefusedError("post listener disappeared")),
+        URLError(OSError("network unreachable")),
+        TimeoutError("timed out"),
+        HTTPError(dossier_cli.REFRESH_URL, 503, "unavailable", hdrs=None, fp=None),
+        json.JSONDecodeError("malformed", "", 0),
+    ],
+)
+def test_refresh_once_post_transport_errors_fail_closed(monkeypatch, transport_error):
+    calls = []
+    local_calls = []
+
+    def fake_loopback(_request, *, timeout):
+        calls.append(timeout)
+        if len(calls) == 1:
+            return 200, {"status": "ok"}
+        raise transport_error
+
+    monkeypatch.setattr(dossier_cli, "_open_loopback_json", fake_loopback)
+    monkeypatch.setattr(dossier_cli, "init_db", lambda: local_calls.append("init"))
+
+    result = CliRunner().invoke(dossier_cli.app, ["refresh-once"])
+
+    assert result.exit_code == 1
+    assert calls == [dossier_cli.HEALTH_TIMEOUT_SECONDS, dossier_cli.REFRESH_TIMEOUT_SECONDS]
+    assert local_calls == []
+
+
