+def test_open_loopback_json_uses_explicit_proxy_free_opener_without_mutating_env(monkeypatch):
+    proxy_env = {
+        "HTTP_PROXY": "http://proxy.invalid:8080",
+        "HTTPS_PROXY": "http://proxy.invalid:8443",
+        "ALL_PROXY": "socks5://proxy.invalid:1080",
+        "NO_PROXY": "example.invalid",
+    }
+    for name, value in proxy_env.items():
+        monkeypatch.setenv(name, value)
+
+    built_handlers = []
+    opened = []
+
+    class FakeOpener:
+        def open(self, request, *, timeout):
+            opened.append((request, timeout))
+            if len(opened) == 1:
+                return _Response(200, {"status": "ok"})
+            return _Response(200, _valid_refresh_result())
+
+    def fake_build_opener(*handlers):
+        built_handlers.append(handlers)
+        return FakeOpener()
+
+    monkeypatch.setattr(dossier_cli, "build_opener", fake_build_opener)
+
+    health = dossier_cli._open_loopback_json(
+        dossier_cli.HEALTH_URL,
+        timeout=dossier_cli.HEALTH_TIMEOUT_SECONDS,
+    )
+    refresh = dossier_cli._open_loopback_json(
+        dossier_cli.Request(dossier_cli.REFRESH_URL, data=b"", method="POST"),
+        timeout=dossier_cli.REFRESH_TIMEOUT_SECONDS,
+    )
+
+    assert health == (200, {"status": "ok"})
+    assert refresh == (200, _valid_refresh_result())
+    assert len(built_handlers) == 2
+    assert all(len(handlers) == 1 for handlers in built_handlers)
+    assert all(isinstance(handlers[0], ProxyHandler) for handlers in built_handlers)
+    assert all(handlers[0].proxies == {} for handlers in built_handlers)
+    assert opened[0] == (dossier_cli.HEALTH_URL, dossier_cli.HEALTH_TIMEOUT_SECONDS)
+    assert opened[1][0].full_url == dossier_cli.REFRESH_URL
+    assert opened[1][0].method == "POST"
+    assert opened[1][1] == dossier_cli.REFRESH_TIMEOUT_SECONDS
+    assert {name: dossier_cli.os.environ[name] for name in proxy_env} == proxy_env
+
+
+def test_refresh_once_routes_health_and_post_through_loopback_seam(monkeypatch):
+    calls = []
+
+    def fake_loopback(request, *, timeout):
+        calls.append((request, timeout))
+        if len(calls) == 1:
+            return 200, {"status": "ok"}
+        return 200, _valid_refresh_result()
+
+    monkeypatch.setattr(dossier_cli, "_open_loopback_json", fake_loopback)
+    monkeypatch.setattr(dossier_cli, "init_db", lambda: (_ for _ in ()).throw(AssertionError("no local DB")))
+
+    result = CliRunner().invoke(dossier_cli.app, ["refresh-once"])
+
+    assert result.exit_code == 0
+    assert len(calls) == 2
+    assert calls[0] == (dossier_cli.HEALTH_URL, dossier_cli.HEALTH_TIMEOUT_SECONDS)
+    assert calls[1][0].full_url == dossier_cli.REFRESH_URL
+    assert calls[1][0].method == "POST"
+    assert calls[1][1] == dossier_cli.REFRESH_TIMEOUT_SECONDS
+
+
+@pytest.mark.parametrize(
+    "transport_error",
+    [
+        HTTPError(dossier_cli.HEALTH_URL, 503, "unavailable", hdrs=None, fp=None),
+        OSError("network unreachable"),
+    ],
+)
